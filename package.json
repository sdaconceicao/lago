    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "react": "^19",
    "react-aria-components": "^1",
    "react-dom": "^19"
  },
