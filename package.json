{
  "name": "@code-x/lago",
  "version": "0.10.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.1.0",
  "scripts": {
    "build": "vite build --config vite.build.config.ts",
    "size": "node scripts/bundle-size.mjs check",
    "size:record": "node scripts/bundle-size.mjs record",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:setup": "pnpm exec playwright install --with-deps chromium",
    "test": "vitest run",
    "test:bundle-size": "node --test scripts/bundle-size.test.mjs",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "type-check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p .storybook/tsconfig.json --noEmit"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "style": "./dist/index.css",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./rich-text-editor": {
      "types": "./dist/rich-text-editor.d.ts",
      "import": "./dist/rich-text-editor.mjs",
      "require": "./dist/rich-text-editor.cjs"
    },
    "./styles": {
      "types": "./styles.d.ts",
      "import": "./dist/index.css",
      "require": "./dist/index.css"
    }
  },
  "files": [
    "dist",
    "styles.d.ts",
    "LICENSE"
  ],
  "peerDependencies": {
    "@tiptap/core": "^3.30.5",
    "@tiptap/extension-highlight": "^3.30.5",
